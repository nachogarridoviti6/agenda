{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agenda",
  "version": "1.0.5",
  "identifier": "com.nachogarrido.agenda",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agenda",
        "url": "index.html",
        "width": 1200,
        "height": 800,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Spanish"
        ],
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "windows/header.bmp",
        "sidebarImage": "windows/sidebar.bmp",
        "installerHooks": "windows/hooks.nsh",
        "startMenuFolder": "Agenda",
        "compression": "lzma"
      }
    },
    "publisher": "Nacho Garrido",
    "copyright": "© 2026 Nacho Garrido",
    "category": "Productivity",
    "shortDescription": "Calendario estilo Apple con widget de escritorio",
    "longDescription": "Agenda es un calendario de escritorio inspirado en Apple Calendar: vistas de día, semana, mes y año, tareas, repeticiones, alertas, añadir rápido en lenguaje natural, sincronización con iCloud y un widget fijado en el fondo del escritorio con tu semana.",
    "fileAssociations": [
      {
        "ext": [
          "ics"
        ],
        "name": "Calendario iCalendar",
        "description": "Calendario (.ics)",
        "role": "Viewer",
        "mimeType": "text/calendar"
      }
    ]
  }
}
